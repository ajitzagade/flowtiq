# Flowtiq Mobile — iOS Fastlane configuration
# Requires: Ruby, Bundler (`bundle install` in apps/mobile/ios/)
#
# Environment variables required (beta/release lanes):
#   APPLE_TEAM_ID                     — Apple Developer Team ID
#   APP_STORE_CONNECT_API_KEY_ID      — ASC API Key ID
#   APP_STORE_CONNECT_API_ISSUER_ID   — ASC API Issuer ID
#   APP_STORE_CONNECT_API_KEY_CONTENT — ASC API Key .p8 content, base64 encoded
#   MATCH_PASSWORD                    — fastlane match repo encryption password
#   MATCH_GIT_URL                     — private match certificates repo URL
#   BUILD_NUMBER                      — build number (use GitHub run number in CI)
#
# Environment variables required (build_unsigned lane):
#   BUILD_NUMBER (optional)           — injected into CFBundleVersion; defaults to timestamp

default_platform(:ios)

platform :ios do
  # ── build_unsigned lane — no-code-signing IPA for ad-hoc distribution ───────
  # Output: apps/mobile/ios/build/FlowtiqMobile-unsigned.ipa
  # Prerequisites: Xcode selected, pod install done, FlowtiqMobile.xcworkspace present
  lane :build_unsigned do
    build_number = ENV["BUILD_NUMBER"] || Time.now.to_i.to_s

    # Stamp the build number so it shows in the app's About screen / Settings
    increment_build_number(build_number: build_number)

    archive_path = File.expand_path("../build/FlowtiqMobile.xcarchive", __dir__)
    ipa_dir      = File.expand_path("../build",                          __dir__)

    # ── Step 1: archive without code signing ────────────────────────────────
    sh(
      "xcodebuild archive" \
      " -workspace FlowtiqMobile.xcworkspace" \
      " -scheme FlowtiqMobile" \
      " -configuration Release" \
      " -archivePath '#{archive_path}'" \
      " CODE_SIGNING_REQUIRED=NO" \
      " CODE_SIGN_IDENTITY=''" \
      " CODE_SIGNING_ALLOWED=NO" \
      " | xcpretty || true"
    )

    UI.user_error!("Archive not found — xcodebuild failed") unless File.exist?(archive_path)

    # ── Step 2: package .app → unsigned .ipa ────────────────────────────────
    app_path   = "#{archive_path}/Products/Applications/FlowtiqMobile.app"
    payload_dir = "#{ipa_dir}/.unsigned_tmp/Payload"
    ipa_path   = "#{ipa_dir}/FlowtiqMobile-unsigned.ipa"

    sh("rm -rf '#{ipa_dir}/.unsigned_tmp'")
    sh("mkdir -p '#{payload_dir}'")
    sh("cp -r '#{app_path}' '#{payload_dir}/'")
    sh("cd '#{ipa_dir}/.unsigned_tmp' && zip -qr '#{ipa_path}' Payload")
    sh("rm -rf '#{ipa_dir}/.unsigned_tmp'")

    UI.success("Unsigned IPA → #{ipa_path}")
  end

  # ── beta lane — build and upload to TestFlight ──────────────────────────────
  lane :beta do
    # Authenticate with App Store Connect API key (no Apple ID / 2FA needed)
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Sync certificates and provisioning profiles via match
    # readonly: true — CI must never write back to the certificates repo
    match(type: "appstore", readonly: true)

    # Increment build number — use BUILD_NUMBER from CI (GitHub run number)
    # Falls back to current Unix timestamp for local runs
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || Time.now.to_i.to_s
    )

    # Build the signed IPA
    gym(
      scheme: "FlowtiqMobile",
      export_method: "app-store",
      configuration: "Release"
    )

    # Upload to TestFlight (skip waiting for Apple to process the build)
    pilot(skip_waiting_for_build_processing: true)
  end
end
